# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables & secrets
.env
.env.*
!.env.example

# Local SQLite databases & app data
data/
*.db
*.sqlite3
*.db-journal

# IDEs & editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating system files
Thumbs.db
.DS_Store

# Pytest / coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Scratch & temporary test scripts
scratch/

# Generated by the test suites in whatever the current directory is (Windows TEMP can
# resolve to the repo root): per-suite databases, extracted EPUBs and cover caches.
# Without these the working tree silently accumulates thousands of throwaway dirs.
tmp*/
tmp*.db
tmp*.epub
test_*.db
noveltrax_*/
noveltrax-*/
challenger_*/
forensic_*/
probe*/
nt_*/
pip-*/
*.epub
*.pdf
covers/

# Agent process artifacts (run reports stay local, not in the repo)
.agents/
.omp/

